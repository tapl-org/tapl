language oymomo
λm. {
  gcd= {
    gives= 'i32',
    body= λf. {
      entry= {
        takes= {a= 'i32', b= 'i32'},
        body= λp. f.loop.body {a= p.a, b= p.b},
      },
      loop= {
        takes= {a= 'i32', b= 'i32'},
        body= λp.
          let z = 'icmp' {'eq', 'i32', p.b, [00000000]} in
          if z then f.done.body {a= p.a} else f.step.body {a= p.a, b= p.b},
      },
      step= {
        takes= {a= 'i32', b= 'i32'},
        body= λp. let r = 'urem' {'i32', p.a, p.b} in f.loop.body {a= p.b, b= r},
      },
      done= {takes= {a= 'i32'}, body= λp. p.a},
    },
  },
  main= {
    gives= 'i32',
    body= λf. {
      entry= {takes= {}, body= λp. m.gcd {a= [30000000], b= [12000000]}},
    },
  },
}
