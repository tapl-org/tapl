putchar(c: i32): i32

hi: i32
  entry():
    q = call putchar([68000000]:i32)
    r = call putchar([69000000]:i32)
    return r

count: i32
  entry():
    jump loop([00000000]:i32)
  loop(i: i32):
    p = call putchar([2a000000]:i32)
    j = add 'i32', i, [01000000]:i32
    done = icmp_eq 'i32', j, [03000000]:i32
    branch done, exit(j), loop(j)
  exit(n: i32):
    return n
