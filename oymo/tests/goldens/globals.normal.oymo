language oymomo
λm. {
  answer= {type= 'i32', value= [2a000000]},
  counter= {type= 'i32', init= [29000000]},
  main= {
    gives= 'i32',
    body= λf. {
      entry= {
        takes= {},
        body= λp.
          let a = 'load' {'i32', m.answer} in
          let c = 'load' {'i32', m.counter} in
          let d = 'add' {'i32', c, a} in
          let s = 'store' {'i32', d, m.counter} in
          let e = 'load' {'i32', m.counter} in e,
      },
    },
  },
}
