language oymomo
{
  version= '0',
  symbols= {
    fill= {type= {'function', {p= 'ptr', n= 'i64'}, 'i32'}},
    main= {
      type= {'function', {}, 'i32'},
      body= λm. λp. m [] (λr. {
        entry=
          let q = 'alloca' {{x= 'i32', y= 'i64'}} in
          let y = 'getelementptr'
            {{x= 'i32', y= 'i64'}, q, [00000000 00000000], [01000000]} in
          let s = m.fill {p= y, n= [08000000 00000000]} in s,
      }),
    },
  },
}
