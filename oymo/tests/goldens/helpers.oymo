language oymomo
let d = {inc= λx. 'add' {'i32', x, [01000000]}} in
{
  version= '0',
  symbols= {
    main= {
      type= {'function', {n= 'i32'}, 'i32'},
      body= λm. λp. m [] (λr. {
        entry=
          let x = 'mul' {'i32', p.n, [02000000]} in
          let y = d.inc x in y,
      }),
    },
  },
}
