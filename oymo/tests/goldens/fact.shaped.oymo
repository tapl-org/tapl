language oymomo
module~{main= ⇒ 'i32'} → {
  main= f → {
    entry= args~{} → f.loop {acc= [01000000]~'i32', n= [05000000]~'i32'},
    loop= args~{acc= 'i32', n= 'i32'} →
      let next = 'mul' {'i32', args.acc, args.n} in
      let m = 'sub' {'i32', args.n, [01000000]~'i32'} in
      let done = 'icmp_eq' {'i32', m, [00000000]~'i32'} in
      if done then f.exit {acc= next} else f.loop {acc= next, n= m},
    exit= args~{acc= 'i32'} → args.acc,
  },
}
