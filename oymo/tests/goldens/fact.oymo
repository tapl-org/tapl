language oymomo
{
  version= '0',
  symbols= {
    main= {
      type= {'function', {}, 'i32'},
      body= λm. λp. m [] (λr. {
        entry= r.loop [01000000] [05000000],
        loop= λacc. λn.
          let next = 'mul' {'i32', acc, n} in
          let k = 'sub' {'i32', n, [01000000]} in
          let done = 'icmp' {'eq', 'i32', k, [00000000]} in
          if done then r.exit next else r.loop next k,
        exit= λacc. acc,
      }),
    },
  },
}
