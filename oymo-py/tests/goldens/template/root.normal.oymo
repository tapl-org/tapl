language oymomo
{
  max32= {
    type= {'function', {a= 'i32', b= 'i32'}, 'i32'},
    body= λg. λp. 'R' (λr. {
      let c = 'icmp' {'sgt', 'i32', p.a, p.b} in
      'R' (λq. {if c then q.first else q.second, first= p.a, second= p.b}),
    }),
  },
  main= {
    type= {'function', {}, 'i32'},
    link= 'main',
    body= λg. λp. 'R' (λr. {let m = g.max32 {a= [03000000], b= [09000000]} in m}),
  },
}
