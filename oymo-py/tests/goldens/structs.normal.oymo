language oymomo
{
  second= {
    type= {'function', {a= 'i32', b= 'i8'}, 'i32'},
    body= λg. λp. 'R' (λr. {
      entry=
        let s1 = 'insertvalue' {{'i8', 'i32'}, {[00], [00000000]}, p.b, [00]} in
        let s2 = 'insertvalue' {{'i8', 'i32'}, s1, p.a, [01]} in
        let y = 'extractvalue' {{'i8', 'i32'}, s2, [01]} in y,
    }),
  },
  main= {
    type= {'function', {}, 'i32'},
    link= 'main',
    body= λg. λp. 'R' (λr. {
      entry= let y = g.second {a= [07000000], b= [01]} in y,
    }),
  },
}
