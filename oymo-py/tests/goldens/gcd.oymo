language oymomo
{
  gcd= {
    type= {'function', {a= 'i32', b= 'i32'}, 'i32'},
    body= λg. λp. g [] (λr. {
      entry= r.loop p.a p.b,
      loop= λa. λb.
        let z = 'icmp' {'eq', 'i32', b, [00000000]} in
        g [] (λq. {
          if z then r.done a else q.step,
          step= let c = 'urem' {'i32', a, b} in r.loop b c,
        }),
      done= λc. c,
    }),
  },
  main= {
    type= {'function', {}, 'i32'},
    link= 'main',
    body= λg. λp. g [] (λr. {
      entry= let y = g.gcd {a= [30000000], b= [12000000]} in y,
    }),
  },
}
