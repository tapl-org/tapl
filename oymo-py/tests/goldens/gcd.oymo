language oymomo
{
  version= '0',
  symbols= {
    gcd= {
      type= {'function', {a= 'i32', b= 'i32'}, 'i32'},
      body= λm. λp. m [] (λr. {
        entry= r.loop p.a p.b,
        loop= λa. λb.
          let z = 'icmp' {'eq', 'i32', b, [00000000]} in
          m [] (λq. {
            if z then r.done a else q.step,
            step= let c = 'urem' {'i32', a, b} in r.loop b c,
          }),
        done= λc. c,
      }),
    },
    main= {
      type= {'function', {}, 'i32'},
      body= λm. λp. m [] (λr. {
        entry= let y = m.gcd {a= [30000000], b= [12000000]} in y,
      }),
    },
  },
}
