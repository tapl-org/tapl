language oymomo
{
  c= {puts= {type= {'function', {s= 'ptr'}, 'i32'}, link= 'puts'}},
  hello= {
    msg= {type= {'array', [06], 'i8'}, value= [68656c6c 6f00]},
    say= {
      type= {'function', {}, 'i32'},
      body= λg. λp. g [] (λr. {let u = g.c.puts {s= g.hello.msg} in u}),
    },
  },
  bye= {
    msg= {type= {'array', [04], 'i8'}, value= [62796500]},
    say= {
      type= {'function', {}, 'i32'},
      body= λg. λp. g [] (λr. {let u = g.c.puts {s= g.bye.msg} in u}),
    },
  },
  main= {
    type= {'function', {}, 'i32'},
    link= 'main',
    body= λg. λp. g [] (λr. {
      let a = g.hello.say {} in
      let b = g.bye.say {} in [00000000],
    }),
  },
}
