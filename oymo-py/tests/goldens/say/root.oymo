language oymomo
'unit.merge'
  {
    'driver.read_low' 'say/hello.oymo',
    'driver.read_low' 'say/bye.oymo',
    {
      main= {
        type= {'function', {}, 'i32'},
        link= 'main',
        body= λg. λp. 'R' (λr. {
          let a = g.hello.say {} in
          let b = g.bye.say {} in [00000000],
        }),
      },
    },
  }
