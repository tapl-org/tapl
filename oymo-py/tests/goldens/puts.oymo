language oymomo
{
  puts= {type= {'function', {s= 'ptr'}, 'i32'}, link= 'puts'},
  msg= {type= {'array', [03], 'i8'}, value= [686900]},
  main= {
    type= {'function', {argc= 'i32'}, 'i32'},
    link= 'main',
    body= λg. λp. 'R' (λr. {
      entry=
        let c = 'icmp' {'sgt', 'i32', p.argc, [01000000]} in
        'R' (λq. {
          if c then q.say else r.done,
          say= let u = g.puts {s= g.msg} in r.done,
        }),
      done= [00000000],
    }),
  },
}
